# Local FastAPI service. Override this with the deployed API origin in hosting.
VITE_API_BASE_URL=http://localhost:8000
VITE_USE_MOCK_API=false

# Public build-time severity, independent of API selection. Rebuild to change.
VITE_LOG_LEVEL=INFO
ENV=dev

# Used only when VITE_USE_MOCK_API is not false.
VITE_MOCK_LATENCY_MS=120
